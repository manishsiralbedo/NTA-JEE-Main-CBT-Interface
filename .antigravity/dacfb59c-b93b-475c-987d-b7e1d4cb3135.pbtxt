        }
        lines {
          text: "    questionText: \'The oxidation state of chromium in potassium dichromate $\\\\text{K}_2\\\\text{Cr}_2\\\\text{O}_7$ and chromyl chloride $\\\\text{CrO}_2\\\\text{Cl}_2$ are respectively:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$+6$ and $+6$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$+6$ and $+4$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$+3$ and $+6$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$+6$ and $+2$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'In $\\\\text{K}_2\\\\text{Cr}_2\\\\text{O}_7$: $2(+1) + 2x + 7(-2) = 0 \\\\implies x = +6$. In $\\\\text{CrO}_2\\\\text{Cl}_2$: $x + 2(-2) + 2(-1) = 0 \\\\implies x = +6$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
