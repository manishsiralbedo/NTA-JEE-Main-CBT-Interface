          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'Compounds containing $\\\\text{CH}_3-\\\\text{C}(=\\\\text{O})-$ or oxidizable to it like $\\\\text{CH}_3-\\\\text{CH(OH)}-$ give positive iodoform test. Butan-2-ol has this group.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
