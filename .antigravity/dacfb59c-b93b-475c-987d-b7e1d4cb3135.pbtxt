          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionText: \'A vernier calliper has 10 divisions on the vernier scale coinciding with 9 divisions on the main scale. If $1\\\\text{ MSD} = 1\\\\text{ mm}$, the least count of the vernier calliper in units of $10^{-1}\\\\text{ mm}$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'$\\\\text{Least Count} = 1\\\\text{ MSD} - 1\\\\text{ VSD} = 1\\\\text{ mm} - 0.9\\\\text{ mm} = 0.1\\\\text{ mm} = 1 \\\\times 10^{-1}\\\\text{ mm}$. Answer is 1.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
