        }
        lines {
          text: "    explanation: \'$f(x) = \\\\sqrt{2} \\\\sin(x + \\\\pi/4)$. The maximum is $\\\\sqrt{2}$, occurring at $x = \\\\pi/4$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
