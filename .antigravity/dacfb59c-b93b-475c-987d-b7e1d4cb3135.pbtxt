        lines {
          text: "    questionText: \'The coagulation power of electrolytes for an arsenious sulphide ($\\text{As}_2\\text{S}_3$, negatively charged) sol follows Hardy-Schulze rule in the order:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
