        }
        lines {
          text: "    type: \'MCQ\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    questionText: \'The spin-only magnetic moment of $[\\\\text{Fe(CN)}_6]^{4-}$ and $[\\\\text{Fe(H}_2\\\\text{O)}_6]^{2+}$ respectively in Bohr Magneton (BM) are:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$0\\\\text{ BM}$ and $4.9\\\\text{ BM}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$4.9\\\\text{ BM}$ and $0\\\\text{ BM}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$2.8\\\\text{ BM}$ and $5.9\\\\text{ BM}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$1.73\\\\text{ BM}$ and $3.87\\\\text{ BM}$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'$\\\\text{Fe}^{2+}$ is $3d^6$. $\\\\text{CN}^-$ is a strong field ligand, causing pairing $\\\\implies t_{2g}^6 e_g^0$ ($n=0$ unpaired electrons, $\\\\mu = 0$). $\\\\text{H}_2\\\\text{O}$ is weak field $\\\\implies t_{2g}^4 e_g^2$ ($n=4$ unpaired electrons, $\\\\mu = \\\\sqrt{4(6)} \\\\approx 4.90\\\\text{ BM}$).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
