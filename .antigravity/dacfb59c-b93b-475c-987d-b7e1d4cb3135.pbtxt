        lines {
          text: "    questionText: \'The angle $\\\\theta$ between the vectors $\\\\vec{a} = 2\\\\hat{i} + \\\\hat{j} - \\\\hat{k}$ and $\\\\vec{b} = \\\\hat{i} - \\\\hat{j} + 2\\\\hat{k}$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$\\\\frac{\\\\pi}{2}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
