        lines {
          text: "    questionText: \'The slope of the tangent to the curve $y = x^3 - 3x + 2$ at the point where $x = 2$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
