          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$100$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'Number of terms is $\\\\binom{n + k - 1}{k - 1} = \\\\binom{10 + 3 - 1}{3 - 1} = \\\\binom{12}{2} = \\\\frac{12 \\\\times 11}{2} = 66$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
