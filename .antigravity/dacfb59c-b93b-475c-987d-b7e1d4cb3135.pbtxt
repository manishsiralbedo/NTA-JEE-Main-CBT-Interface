          text: "    type: \'MCQ\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    questionText: \'Which of the following compounds gives a positive haloform (iodoform) test upon treatment with $\\\\text{I}_2 / \\\\text{NaOH}$?\',"
