          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'2\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'It is a square planar complex of type $[\\\\text{Ma}_2\\\\text{b}_2]$. It exhibits two geometrical isomers: cis and trans. Answer is 2.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
