          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    questionText: \'According to Molecular Orbital Theory (MOT), the bond orders of $\\\\text{O}_2, \\\\text{O}_2^+, \\\\text{O}_2^-, \\\\text{O}_2^{2-}$ follow the order:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$\\\\text{O}_2^+ > \\\\text{O}_2 > \\\\text{O}_2^- > \\\\text{O}_2^{2-}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$\\\\text{O}_2^{2-} > \\\\text{O}_2^- > \\\\text{O}_2 > \\\\text{O}_2^+$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$\\\\text{O}_2 > \\\\text{O}_2^+ > \\\\text{O}_2^- > \\\\text{O}_2^{2-}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$\\\\text{O}_2^+ > \\\\text{O}_2^- > \\\\text{O}_2 > \\\\text{O}_2^{2-}$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'Bond orders: $\\\\text{O}_2^+ = 2.5$, $\\\\text{O}_2 = 2.0$, $\\\\text{O}_2^- = 1.5$, $\\\\text{O}_2^{2-} = 1.0$. Thus, $\\\\text{O}_2^+ > \\\\text{O}_2 > \\\\text{O}_2^- > \\\\text{O}_2^{2-}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
