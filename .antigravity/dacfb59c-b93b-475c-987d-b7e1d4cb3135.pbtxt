        }
        lines {
          text: "    explanation: \'$v_{\\\\max} = \\\\sqrt{\\\\mu_s g r} = \\\\sqrt{0.2 \\\\times 10 \\\\times 50} = \\\\sqrt{100} = 10\\\\text{ m/s}$.\',"
