        lines {
          text: "      { id: \'3\', label: \'$\\\\text{PO}_4^{3-} > \\\\text{SO}_4^{2-} > \\\\text{Cl}^-$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$\\\\text{Cl}^- > \\\\text{SO}_4^{2-} > \\\\text{PO}_4^{3-}$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
