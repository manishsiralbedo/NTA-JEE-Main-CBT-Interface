          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionText: \'In a hydrogen-like atom, the electron transitions from the $n = 3$ state to the $n = 1$ state. The ratio of de Broglie wavelength in state 3 to state 1 (i.e. $\\\\lambda_3 / \\\\lambda_1$) is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'3\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'Bohr orbit condition gives $2\\\\pi r_n = n \\\\lambda_n$. Velocity $v_n \\\\propto 1/n$, and de Broglie wavelength $\\\\lambda = h / (mv) \\\\propto n$. Thus $\\\\lambda_3 / \\\\lambda_1 = 3 / 1 = 3$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: 24,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    subject: \'Physics\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    section: \'Section B\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    type: \'NUMERICAL\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionText: \'Two soap bubbles of radii $r_1 = 3\\\\text{ cm}$ and $r_2 = 4\\\\text{ cm}$ combine in vacuum under isothermal conditions to form a single spherical bubble of radius $R$. The radius $R$ in cm is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'5\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'Surface energy conservation or pressure relation: $4\\\\pi r_1^2 + 4\\\\pi r_2^2 = 4\\\\pi R^2 \\\\implies R = \\\\sqrt{3^2 + 4^2} = 5\\\\text{ cm}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
