        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'Primary amines react with $\\\\text{CHCl}_3$ and alc. $\\\\text{KOH}$ to form isocyanides (carbylamines), which have a foul smell. This is the Carbylamine test.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
