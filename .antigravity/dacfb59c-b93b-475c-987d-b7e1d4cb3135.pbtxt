        lines {
          text: "    questionText: \'If $f(x) = \\\\ln(x + \\\\sqrt{x^2 + 1})$, then the function $f(x)$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'An odd function\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
