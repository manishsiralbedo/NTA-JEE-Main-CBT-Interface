        lines {
          text: "    questionText: \'The solution of the differential equation $\\\\frac{dy}{dx} + y \\\\tan x = \\\\sec x$, given $y(0) = 1$, is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$y = \\\\sin x + \\\\cos x$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$y = \\\\sin x - \\\\cos x$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$y = \\\\tan x + 1$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$y = \\\\sec x$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'Integrating factor $\\\\text{IF} = e^{\\\\int \\\\tan x dx} = \\\\sec x$. Solution: $y \\\\sec x = \\\\int \\\\sec^2 x dx + C = \\\\tan x + C$. At $x=0, y=1 \\\\implies 1 = C$. Thus $y \\\\sec x = \\\\tan x + 1 \\\\implies y = \\\\sin x + \\\\cos x$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
