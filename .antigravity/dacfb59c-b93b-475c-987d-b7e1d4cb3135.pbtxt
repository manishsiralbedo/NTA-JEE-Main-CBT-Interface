          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionText: \'A parallel plate capacitor having plate area $A$ and separation $d$ is filled with two dielectric slabs of dielectric constants $K_1 = 3$ and $K_2 = 6$, each of thickness $d/2$. The equivalent capacitance of the combination is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'1\', label: \'$4 \\\\frac{\\\\varepsilon_0 A}{d}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'2\', label: \'$\\\\frac{9}{2} \\\\frac{\\\\varepsilon_0 A}{d}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'3\', label: \'$2 \\\\frac{\\\\varepsilon_0 A}{d}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'4\', label: \'$6 \\\\frac{\\\\varepsilon_0 A}{d}$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'Two capacitors in series: $C_1 = \\\\frac{K_1 \\\\varepsilon_0 A}{d/2} = \\\\frac{6 \\\\varepsilon_0 A}{d}$ and $C_2 = \\\\frac{K_2 \\\\varepsilon_0 A}{d/2} = \\\\frac{12 \\\\varepsilon_0 A}{d}$. Equivalent $C_{\\\\text{eq}} = \\\\frac{C_1 C_2}{C_1 + C_2} = \\\\frac{6 \\\\times 12}{18} \\\\frac{\\\\varepsilon_0 A}{d} = 4 \\\\frac{\\\\varepsilon_0 A}{d}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: 5,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
