        }
        lines {
          text: "    questionText: \'In a series $LCR$ circuit connected to an AC source of voltage $V(t) = V_0 \\\\sin(\\\\omega t)$, the resonance frequency is $\\\\omega_0 = \\\\frac{1}{\\\\sqrt{LC}}$. If the quality factor is $Q = 50$ and the bandwidth is $\\\\Delta \\\\omega = 200\\\\text{ rad/s}$, then the resonant frequency $\\\\omega_0$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'1\', label: \'$10^4\\\\text{ rad/s}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'2\', label: \'$5 \\\\times 10^3\\\\text{ rad/s}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'3\', label: \'$2 \\\\times 10^4\\\\text{ rad/s}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'4\', label: \'$10^3\\\\text{ rad/s}$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'Quality factor $Q = \\\\frac{\\\\omega_0}{\\\\Delta \\\\omega} \\\\implies \\\\omega_0 = Q \\\\cdot \\\\Delta \\\\omega = 50 \\\\times 200 = 10,000\\\\text{ rad/s} = 10^4\\\\text{ rad/s}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: 3,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
