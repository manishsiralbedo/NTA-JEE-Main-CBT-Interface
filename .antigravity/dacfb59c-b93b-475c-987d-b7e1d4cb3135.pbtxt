        }
        lines {
          text: "    questionText: \'The coagulation power of electrolytes for an arsenious sulphide ($\\text{As}_2\\text{S}_3$, negatively charged) sol follows Hardy-Schulze rule in the order:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$\\\\text{Al}^{3+} > \\\\text{Mg}^{2+} > \\\\text{Na}^+$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$\\\\text{Na}^+ > \\\\text{Mg}^{2+} > \\\\text{Al}^{3+}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$\\\\text{PO}_4^{3-} > \\\\text{SO}_4^{2-} > \\\\text{Cl}^-$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$\\\\text{Cl}^- > \\\\text{SO}_4^{2-} > \\\\text{PO}_4^{3-}$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'For a negatively charged colloid, the flocculating ion is a cation. Higher valency gives greater coagulating power: $\\\\text{Al}^{3+} > \\\\text{Mg}^{2+} > \\\\text{Na}^+$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
