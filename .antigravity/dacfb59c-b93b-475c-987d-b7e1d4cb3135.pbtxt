        lines {
          text: "    type: \'MCQ\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionText: \'The limit $L = \\\\lim_{x \\\\to 0} \\\\frac{\\\\sin(3x) - 3x}{x^3}$ is equal to:\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'1\', label: \'$-\\\\frac{9}{2}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'2\', label: \'$\\\\frac{9}{2}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'3\', label: \'$-\\\\frac{27}{6}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'4\', label: \'$0$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'$\\\\sin(3x) = 3x - \\\\frac{(3x)^3}{6} + O(x^5) = 3x - \\\\frac{27 x^3}{6}$. Hence $\\\\frac{\\\\sin(3x) - 3x}{x^3} \\\\to -\\\\frac{27}{6} = -\\\\frac{9}{2}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: 54,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
