        }
        lines {
          text: "    questionText: \'If $z = \\\\frac{1 + i\\\\sqrt{3}}{1 - i\\\\sqrt{3}}$, then the principal argument $\\\\text{Arg}(z)$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$\\\\frac{2\\\\pi}{3}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$\\\\frac{\\\\pi}{3}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$-\\\\frac{2\\\\pi}{3}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$\\\\pi$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'$1 + i\\\\sqrt{3} = 2 e^{i\\\\pi/3}$ and $1 - i\\\\sqrt{3} = 2 e^{-i\\\\pi/3}$. Thus $z = e^{i(\\\\pi/3 - (-\\\\pi/3))} = e^{i 2\\\\pi/3}$. Principal argument is $\\\\frac{2\\\\pi}{3}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
