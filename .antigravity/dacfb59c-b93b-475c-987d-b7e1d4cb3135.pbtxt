        lines {
          text: "    questionText: \'The coefficient of $x^4$ in the binomial expansion of $\\\\left(x + \\\\frac{2}{x}\\\\right)^8$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
