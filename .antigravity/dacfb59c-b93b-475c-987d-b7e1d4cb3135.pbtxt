        }
        lines {
          text: "    questionText: \'Which of the following compounds gives a positive haloform (iodoform) test upon treatment with $\\\\text{I}_2 / \\\\text{NaOH}$?\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$\\\\text{CH}_3-\\\\text{CH(OH)}-\\\\text{CH}_2-\\\\text{CH}_3$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$\\\\text{CH}_3-\\\\text{CH}_2-\\\\text{CH}_2-\\\\text{OH}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$\\\\text{C}_6\\\\text{H}_5-\\\\text{CH}_2-\\\\text{CHO}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
