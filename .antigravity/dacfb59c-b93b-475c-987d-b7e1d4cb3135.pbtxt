          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    questionText: \'A wire of resistance $R$ is stretched uniformly such that its radius decreases to $\\\\frac{r}{2}$. The new resistance of the wire becomes:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$16 R$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$4 R$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$8 R$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$2 R$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'Volume $V = A L = \\\\text{constant}$. $R = \\\\rho \\\\frac{L}{A} = \\\\rho \\\\frac{V}{A^2}$. Since $A \\\\propto r^2$, $R \\\\propto \\\\frac{1}{r^4}$. Decreasing radius by 2 increases resistance by $2^4 = 16$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: 18,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
