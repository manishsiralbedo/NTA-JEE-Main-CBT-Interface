        }
        lines {
          text: "    type: \'NUMERICAL\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    questionText: \'If the system of linear equations $x + y + z = 6$, $x + 2y + 3z = 10$, $x + 2y + \\\\lambda z = \\\\mu$ has infinitely many solutions, the value of $\\\\lambda + \\\\mu$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'13\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'For infinitely many solutions, rows must be linearly dependent. Comparing equation 2 and 3 gives $\\\\lambda = 3$ and $\\\\mu = 10$. Hence $\\\\lambda + \\\\mu = 3 + 10 = 13$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: 73,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subject: \'Mathematics\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
