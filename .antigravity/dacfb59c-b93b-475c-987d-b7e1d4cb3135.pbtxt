        }
        lines {
          text: "    questionText: \'The standard reduction potentials for $\\\\text{Zn}^{2+}/\\\\text{Zn}$ and $\\\\text{Cu}^{2+}/\\\\text{Cu}$ are $-0.76\\\\text{ V}$ and $+0.34\\\\text{ V}$ respectively. The standard emf ($E^\\\\circ$) of the Daniell cell is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
