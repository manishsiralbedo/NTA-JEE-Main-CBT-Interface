        }
        lines {
          text: "    questionText: \'A $0.05\\\\text{ m}$ aqueous solution of a non-volatile non-electrolyte solute freezes at $-0.093^\\\\circ\\\\text{C}$. If $K_f$ for water is $1.86\\\\text{ K kg mol}^{-1}$, the van \\\'t Hoff factor $i$ of the solute is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'$\\\\Delta T_f = i K_f m \\\\implies 0.093 = i \\\\times 1.86 \\\\times 0.05 = i \\\\times 0.093 \\\\implies i = 1$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
