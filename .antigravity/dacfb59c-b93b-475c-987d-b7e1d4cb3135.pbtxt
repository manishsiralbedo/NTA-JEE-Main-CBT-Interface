        lines {
          text: "    questionText: \'The oxidation state of chromium in potassium dichromate $\\\\text{K}_2\\\\text{Cr}_2\\\\text{O}_7$ and chromyl chloride $\\\\text{CrO}_2\\\\text{Cl}_2$ are respectively:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$+6$ and $+6$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
