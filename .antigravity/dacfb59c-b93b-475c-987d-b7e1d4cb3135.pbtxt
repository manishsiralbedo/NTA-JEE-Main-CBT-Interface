        }
        lines {
          text: "    explanation: \'$\\\\text{Lu}^{3+}$ has electron configuration $[\\\\text{Xe}] 4f^{14}$, where the $4f$ subshell is completely filled, having zero unpaired electrons, hence diamagnetic.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
