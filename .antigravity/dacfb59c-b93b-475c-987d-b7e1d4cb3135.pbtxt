        }
        lines {
          text: "    explanation: \'$e = \\\\sqrt{1 + \\\\frac{b^2}{a^2}} = \\\\sqrt{1 + \\\\frac{9}{16}} = \\\\sqrt{\\\\frac{25}{16}} = \\\\frac{5}{4}$.\',"
