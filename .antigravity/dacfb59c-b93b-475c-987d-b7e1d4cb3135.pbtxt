        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'$\\\\frac{dy}{dx} = 3x^2 - 3$. At $x=2$, $\\\\frac{dy}{dx} = 3(4) - 3 = 12 - 3 = 9$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
