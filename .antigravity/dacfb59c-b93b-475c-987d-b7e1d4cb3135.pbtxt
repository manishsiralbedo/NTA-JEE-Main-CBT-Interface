        }
        lines {
          text: "    explanation: \'Center $(g, f) = (2, -3)$, $c = -12$. Radius $R = \\\\sqrt{g^2 + f^2 - c} = \\\\sqrt{4 + 9 - (-12)} = \\\\sqrt{25} = 5$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
