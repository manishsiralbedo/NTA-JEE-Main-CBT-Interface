          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionText: \'An ideal gas undergoes a cyclic process consisting of three steps: an isothermal expansion at $T_1$, an isobaric compression, and an adiabatic compression back to the initial state. The efficiency $\\\\eta$ of this cycle depends on the adiabatic index $\\\\gamma$. If $\\\\gamma = 1.4$ and the compression ratio is $r = 8$, the work done by the gas is given by $\\\\oint P dV$. Which statement is TRUE?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'1\', label: \'Net heat absorbed by the engine in the cycle is positive.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'2\', label: \'Net work done in an anticlockwise $P-V$ cycle is positive.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'3\', label: \'Internal energy change over the complete cycle is $\\\\Delta U > 0$.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { id: \'4\', label: \'Heat rejected during isobaric compression is zero.\' }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'Since the engine operates as a heat engine in a clockwise direction on the $P-V$ diagram, net work is positive, so net heat absorbed $Q_{\\\\text{net}} = W_{\\\\text{net}} > 0$. Over any closed cycle, $\\\\Delta U = 0$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: 4,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
