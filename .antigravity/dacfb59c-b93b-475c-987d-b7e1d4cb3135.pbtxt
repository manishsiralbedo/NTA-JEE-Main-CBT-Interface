        }
        lines {
          text: "    questionText: \'The total number of lone pairs of electrons in the $\\\\text{I}_3^-$ (triiodide) ion is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'9\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'The central iodine atom has 3 lone pairs and 2 bond pairs ($sp^3d$). Each of the two terminal iodine atoms has 3 lone pairs. Total lone pairs = $3 + 3 + 3 = 9$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
