        }
        lines {
          text: "    questionText: \'If $\\\\sin^{-1} x + \\\\sin^{-1} y = \\\\frac{\\\\pi}{2}$, then the value of $\\\\cos^{-1} x + \\\\cos^{-1} y$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$\\\\frac{\\\\pi}{2}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$\\\\pi$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$0$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$\\\\frac{3\\\\pi}{2}$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'Since $\\\\sin^{-1} t + \\\\cos^{-1} t = \\\\frac{\\\\pi}{2}$, $(\\\\frac{\\\\pi}{2} - \\\\cos^{-1} x) + (\\\\frac{\\\\pi}{2} - \\\\cos^{-1} y) = \\\\frac{\\\\pi}{2} \\\\implies \\\\cos^{-1} x + \\\\cos^{-1} y = \\\\frac{\\\\pi}{2}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
