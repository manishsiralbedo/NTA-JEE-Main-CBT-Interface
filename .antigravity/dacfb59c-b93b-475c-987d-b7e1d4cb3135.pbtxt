        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'$T_{r+1} = \\\\binom{8}{r} x^{8-r} (2/x)^r = \\\\binom{8}{r} 2^r x^{8-2r}$. For exponent 4: $8 - 2r = 4 \\\\implies r = 2$. Coefficient is $\\\\binom{8}{2} 2^2 = 28 \\\\times 4 = 112$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
