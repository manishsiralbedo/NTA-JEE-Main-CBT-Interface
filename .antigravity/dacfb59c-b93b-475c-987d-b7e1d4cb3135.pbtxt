        lines {
          text: "    questionText: \'The radius of the circle $x^2 + y^2 - 4x + 6y - 12 = 0$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
