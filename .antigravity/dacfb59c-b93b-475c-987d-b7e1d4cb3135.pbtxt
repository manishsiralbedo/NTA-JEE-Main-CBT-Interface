        lines {
          text: "    questionText: \'The number of terms in the expansion of $(x + y + z)^{10}$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$66$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$55$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$78$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$100$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'Number of terms is $\\\\binom{n + k - 1}{k - 1} = \\\\binom{10 + 3 - 1}{3 - 1} = \\\\binom{12}{2} = \\\\frac{12 \\\\times 11}{2} = 66$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
