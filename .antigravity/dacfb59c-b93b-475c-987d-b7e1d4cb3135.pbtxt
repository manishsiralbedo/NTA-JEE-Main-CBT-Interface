        lines {
          text: "      { id: \'4\', label: \'$-3\\\\hat{i} + \\\\hat{j} + 7\\\\hat{k}$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'$\\\\vec{b}_1 \\\\times \\\\vec{b}_2 = \\\\begin{vmatrix} \\\\hat{i} & \\\\hat{j} & \\\\hat{k} \\\\\\\\ 2 & -1 & 1 \\\\\\\\ 3 & -5 & 2 \\\\end{vmatrix} = \\\\hat{i}(-2 + 5) - \\\\hat{j}(4 - 3) + \\\\hat{k}(-10 + 3) = 3\\\\hat{i} - \\\\hat{j} - 7\\\\hat{k}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
