        }
        lines {
          text: "    questionText: \'Equal volumes of $0.1\\\\text{ M } \\\\text{CH}_3\\\\text{COOH}$ ($K_a = 1.8 \\\\times 10^{-5}$) and $0.1\\\\text{ M } \\\\text{CH}_3\\\\text{COONa}$ are mixed together. The pH of the resulting buffer solution is equal to:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$-\\\\log_{10}(K_a)$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$7.0$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$14 - \\\\text{p}K_a$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$\\\\frac{1}{2}\\\\text{p}K_a$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'By Henderson-Hasselbalch equation: $\\\\text{pH} = \\\\text{p}K_a + \\\\log\\\\frac{[\\\\text{Salt}]}{[\\\\text{Acid}]}$. Since concentrations are equal, $\\\\log(1) = 0 \\\\implies \\\\text{pH} = \\\\text{p}K_a = -\\\\log_{10}(K_a)$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
