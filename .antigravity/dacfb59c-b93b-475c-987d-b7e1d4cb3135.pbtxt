        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'$1 + i\\\\sqrt{3} = 2 e^{i\\\\pi/3}$ and $1 - i\\\\sqrt{3} = 2 e^{-i\\\\pi/3}$. Thus $z = e^{i(\\\\pi/3 - (-\\\\pi/3))} = e^{i 2\\\\pi/3}$. Principal argument is $\\\\frac{2\\\\pi}{3}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
