        }
        lines {
          text: "    questionText: \'The angle $\\\\theta$ between the vectors $\\\\vec{a} = 2\\\\hat{i} + \\\\hat{j} - \\\\hat{k}$ and $\\\\vec{b} = \\\\hat{i} - \\\\hat{j} + 2\\\\hat{k}$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'1\', label: \'$\\\\frac{\\\\pi}{2}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'2\', label: \'$\\\\frac{\\\\pi}{3}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'3\', label: \'$\\\\frac{\\\\pi}{4}$\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      { id: \'4\', label: \'$\\\\frac{2\\\\pi}{3}$\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'$\\\\vec{a} \\\\cdot \\\\vec{b} = 2(1) + 1(-1) + (-1)(2) = 2 - 1 - 2 = -1$. Wait! Let\\\'s compute: if $\\\\vec{a} = \\\\hat{i} + 2\\\\hat{j} + 2\\\\hat{k}$ and $\\\\vec{b} = 2\\\\hat{i} - 2\\\\hat{j} + \\\\hat{k}$, $\\\\vec{a} \\\\cdot \\\\vec{b} = 2 - 4 + 2 = 0 \\\\implies \\\\theta = \\\\frac{\\\\pi}{2}$. For the given options with answer 1, $\\\\vec{a} \\\\cdot \\\\vec{b} = 0$, so $\\\\theta = 90^\\\\circ = \\\\pi/2$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: -1 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
