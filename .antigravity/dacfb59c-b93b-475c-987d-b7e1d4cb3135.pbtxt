        }
        lines {
          text: "    questionText: \'The oxidation number of sulfur in the tetrathionate ion $(\\\\text{S}_4\\\\text{O}_6^{2-})$ is $+x$. The average oxidation number of sulfur is $+2.5$. Find the number of sulfur atoms with oxidation state zero.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctAnswer: \'2\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \'The structure is $^-\\\\text{O}_3\\\\text{S}-\\\\text{S}-\\\\text{S}-\\\\text{SO}_3^-$. The two terminal sulfur atoms have oxidation state $+5$, and the two central bridging sulfur atoms have oxidation state $0$. Number of zero oxidation sulfur atoms is 2.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    marks: { correct: 4, incorrect: 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
