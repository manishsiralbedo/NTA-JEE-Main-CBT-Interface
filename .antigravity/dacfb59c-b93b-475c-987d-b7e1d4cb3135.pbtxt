          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionText: \'The value of $\\\\det(A)$ for $A = \\\\begin{pmatrix} 2 & 0 & 1 \\\\\\\\ 1 & 3 & 2 \\\\\\\\ 0 & 2 & 4 \\\\end{pmatrix}$ is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'18\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'$\\\\det(A) = 2(3 \\\\times 4 - 2 \\\\times 2) - 0 + 1(1 \\\\times 2 - 3 \\\\times 0) = 2(12 - 4) + 1(2) = 16 + 2 = 18$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
