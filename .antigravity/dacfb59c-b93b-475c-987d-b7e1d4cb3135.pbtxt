        lines {
          text: "    questionText: \'A wire of length $L = 1\\\\text{ m}$ carries a current of $I = 2\\\\text{ A}$ in a uniform magnetic field $B = 0.5\\\\text{ T}$ perpendicular to the wire. The magnetic force on the wire in Newtons is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    correctAnswer: \'1\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'$F = I L B \\\\sin(90^\\\\circ) = 2 \\\\times 1 \\\\times 0.5 = 1\\\\text{ N}$.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    marks: { correct: 4, incorrect: 0 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: 23,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
