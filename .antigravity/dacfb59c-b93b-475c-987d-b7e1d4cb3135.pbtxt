        }
        lines {
          text: "    questionText: \'An inductor of self-inductance $L = 2\\\\text{ H}$ carries a current decreasing at a constant rate $\\\\frac{dI}{dt} = -5\\\\text{ A/s}$. The induced electromotive force (emf) across the inductor is:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
